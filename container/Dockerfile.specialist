# NanoClaw Specialist Container
# Lightweight OpenAI-compatible agent for specialist tasks (no Chromium, no claude-code)

FROM node:22-slim

RUN apt-get update && apt-get install -y \
    curl \
    git \
    grep \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY specialist-runner/package*.json ./
RUN npm install

COPY specialist-runner/ ./
RUN npm run build

RUN mkdir -p /workspace/group /workspace/ipc/requests
RUN chown -R node:node /workspace && chmod 777 /home/node

USER node
WORKDIR /workspace/group

ENTRYPOINT ["node", "/app/dist/index.js"]
